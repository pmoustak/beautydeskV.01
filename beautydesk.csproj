<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>BeautyDesk</RootNamespace>
    <AssemblyName>beautydesk</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>beautydesk.ico</ApplicationIcon>
    <Product>beautydesk</Product>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Periklis Moustaka</Authors>
    <Company>Periklis Moustaka</Company>
    <Copyright>© 2026 Periklis Moustaka</Copyright>
    <Description>Hidden launcher panels for the Windows desktop</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="beautydesk.ico" LogicalName="beautydesk.ico" />
  </ItemGroup>

</Project>
